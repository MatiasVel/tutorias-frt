# --- Base de datos ---
DATABASE_URL="postgresql://tutorias:cambiar_esta_clave@localhost:5432/tutorias_frt?schema=public"

# --- Servidor ---
PORT=3000
NODE_ENV=development
# Origen del frontend (CORS). Varios separados por coma.
FRONTEND_URL=http://localhost:5173

# --- JWT ---
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# --- Registro ---
# Solo se aceptan correos institucionales de estos dominios (confirmar con la facultad).
ALLOWED_EMAIL_DOMAINS=frt.utn.edu.ar,alu.frt.utn.edu.ar

# --- Archivos (comprobantes de materias aprobadas) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# --- Correo (si SMTP_HOST está vacío, los enlaces se imprimen en consola) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Tutorías FRT <no-reply@frt.utn.edu.ar>"

# --- Admin inicial (usado por el seed) ---
SEED_ADMIN_EMAIL=admin@frt.utn.edu.ar
SEED_ADMIN_PASSWORD=CambiarEstaClave123
