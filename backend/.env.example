# ============================================================
#  Variables del backend. Copiar a .env y completar.
#  NUNCA subir el archivo .env a GitHub.
# ============================================================

# --- Base de datos ---
# Local / Docker: las dos URLs son iguales.
# Neon: DATABASE_URL = cadena "Pooled connection" (host con -pooler)
#       DIRECT_URL   = cadena "Direct connection"   (host sin -pooler)
DATABASE_URL="postgresql://tutorias:cambiar_esta_clave@localhost:5433/tutorias_frt?schema=public"
DIRECT_URL="postgresql://tutorias:cambiar_esta_clave@localhost:5433/tutorias_frt?schema=public"

# --- Servidor ---
PORT=3000
NODE_ENV=development
# URL pública del frontend (se usa en los enlaces de los correos)
FRONTEND_URL=http://localhost:5173

# --- Secretos (generar cada uno con los comandos indicados; mínimo 32 caracteres) ---
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_PEPPER=
# Clave de cifrado de datos personales (32 bytes en base64). SI SE PIERDE, LOS DATOS CIFRADOS NO SE RECUPERAN.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# --- Correos institucionales permitidos (registro e ingreso) ---
ALLOWED_EMAIL_DOMAINS=alu.frt.utn.edu.ar,doc.frt.edu.ar
# Quienes se registran con estos dominios quedan como DOCENTE
PROFESSOR_EMAIL_DOMAINS=doc.frt.edu.ar

# --- Comprobantes (se guardan cifrados en la base) ---
MAX_UPLOAD_MB=3

# --- Envío de correos (elegir UNA opción) ---
# Opción A (recomendada): Brevo API, gratis 300 correos/día -> https://www.brevo.com
BREVO_API_KEY=
# Opción B: SMTP (Brevo SMTP, Gmail con "contraseña de aplicación", etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente (en Brevo debe ser un remitente verificado)
MAIL_FROM_NAME=Tutorías FRT
MAIL_FROM_EMAIL=

# --- Admin inicial (lo crea "npm run seed") ---
SEED_ADMIN_EMAIL=admin@frt.utn.edu.ar
SEED_ADMIN_PASSWORD=CambiarEstaClave123
