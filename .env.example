# Variables para docker-compose (copiar a .env y completar). NUNCA subir .env a GitHub.
POSTGRES_USER=tutorias
POSTGRES_PASSWORD=cambiar_por_clave_segura
POSTGRES_DB=tutorias_frt
# Puerto para conectarse a la base desde pgAdmin/DBeaver en esta PC
DB_PORT=5433

FRONTEND_URL=http://localhost:8080

# --- Secretos: generar cada uno (ver README, paso 3). Mínimo 32 caracteres. ---
JWT_ACCESS_SECRET=
PASSWORD_PEPPER=
# 32 bytes en base64. SI SE PIERDE, LOS DATOS CIFRADOS NO SE RECUPERAN: guardala en un lugar seguro.
DATA_ENCRYPTION_KEY=

# --- Correos institucionales permitidos ---
ALLOWED_EMAIL_DOMAINS=alu.frt.utn.edu.ar,doc.frt.edu.ar
PROFESSOR_EMAIL_DOMAINS=doc.frt.edu.ar

# --- Correo (Brevo, gratis): ver docs/DESPLIEGUE.md. Si queda vacío, el enlace sale en "docker compose logs backend" ---
BREVO_API_KEY=
MAIL_FROM_NAME=Tutorías FRT
MAIL_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

SEED_ADMIN_EMAIL=admin@frt.utn.edu.ar
SEED_ADMIN_PASSWORD=CambiarEstaClave123
